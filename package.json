{
  "name": "notedeck-obsidian",
  "private": true,
  "version": "0.1.0",
  "description": "Obsidian plugin for NoteDeck (Misskey client): clip notes into the vault, post from Obsidian, timeline in the sidebar.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.1.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
